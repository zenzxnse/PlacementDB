<%layout layouts/base %>
<%c++
    using Row = std::unordered_map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto field = [](const Row &row, const std::string &key) -> std::string {
        auto it = row.find(key);
        return it == row.end() ? std::string() : it->second;
    };
    auto items = @@.getPtr<RowList>("items");
    auto page = @@.get<std::string>("page");
    auto total_pages = @@.get<std::string>("total_pages");
    auto query_base = @@.get<std::string>("query_base");
    int page_n = std::max(1, std::atoi(page.c_str()));
    int tp_n = std::max(1, std::atoi(total_pages.c_str()));
%>
<header class="page-header">
    <h1>Your difficulty votes</h1>
    <p>One vote per question. Changing your vote replaces the previous value.</p>
</header>

<%c++ if (items && !items->empty()) { %>
<table class="list-table">
    <caption class="visually-hidden">Your difficulty votes</caption>
    <thead>
        <tr>
            <th scope="col">Question</th>
            <th scope="col">Your vote</th>
            <th scope="col">Voted on</th>
        </tr>
    </thead>
    <tbody>
<%c++ for (const auto &v : *items) { %>
        <tr>
            <th scope="row"><a href="/questions/[[ field(v, "slug") ]]">[[ field(v, "title") ]]</a></th>
            <td><span class="badge">[[ field(v, "value") ]]</span> of 5</td>
            <td>[[ field(v, "voted_at") ]]</td>
        </tr>
<%c++ } %>
    </tbody>
</table>
<%c++ } else { %>
<p>You have not voted on any questions yet. <a href="/questions">Browse questions</a> to rate their difficulty.</p>
<%c++ } %>

<%c++ if (tp_n > 1) { %>
<nav class="pagination" aria-label="Pagination">
<%c++ if (page_n > 1) { %>
    <a href="/account/votes?[[ query_base ]]&page=[[ std::to_string(page_n - 1) ]]" rel="prev">Previous page</a>
<%c++ } %>
    <span aria-current="page">Page [[ page ]]</span>
<%c++ if (page_n < tp_n) { %>
    <a href="/account/votes?[[ query_base ]]&page=[[ std::to_string(page_n + 1) ]]" rel="next">Next page</a>
<%c++ } %>
</nav>
<%c++ } %>