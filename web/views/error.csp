<%inc#include "views/escaped_text.h" %>
<%inc#include "views/view_types.h" %>
<%inc#include "views/error_model.h" %>
<%c++
    auto status_code = @@.get<uint16_t>("status_code");
    auto code = @@.get<EscapedText>("code");
    auto message = @@.get<EscapedText>("message");
    auto request_id = @@.getPtr<EscapedText>("request_id");
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% std::to_string(status_code) %} - PlacementDB</title>
    <link rel="stylesheet" href="/static/css/main.css">
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
        <div class="container">
            <a class="brand" href="/">PlacementDB</a>
            <nav class="site-nav" aria-label="Primary">
                <ul>
                    <li><a href="/questions">Questions</a></li>
                    <li><a href="/experiences">Experiences</a></li>
                    <li><a href="/search">Search</a></li>
                    <li><a href="/login">Log in</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main id="main" tabindex="-1">
        <div class="container error-page">
            <h1>Something went wrong</h1>
            <p class="error-code">Status {% std::to_string(status_code) %} - {% code.value() %}</p>
            <p>{% message.value() %}</p>
<%c++ if (request_id) { %>
            <p>If you report this, include request id <code>{% request_id->value() %}</code>.</p>
<%c++ } %>
            <p><a href="/">Go home</a> &middot; <a href="/questions">Browse questions</a></p>
        </div>
    </main>
    <footer class="site-footer">
        <div class="container">
            <p>PlacementDB is a community question bank for SRM students.</p>
        </div>
    </footer>
</body>
</html>