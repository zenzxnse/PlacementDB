# PlacementDB listens on loopback; Envoy is the only public listener.
PLACEDB_BIND_ADDRESS=127.0.0.1
PLACEDB_PORT=8080
PLACEDB_THREADS=2

PLACEDB_DB_HOST=127.0.0.1
PLACEDB_DB_PORT=5432
PLACEDB_DB_NAME=placedb
PLACEDB_DB_USER=placedb_app
PLACEDB_DB_PASSWORD=replace-through-the-host-secret-store
PLACEDB_DB_CONNECTIONS=4

# Exact browser-visible Envoy origin used for mutation Origin checks.
PLACEDB_PUBLIC_ORIGIN=https://placements.example.edu

# Generate at least 32 random characters; never commit the real value.
PLACEDB_LOGIN_CSRF_MAC_KEY=replace-through-the-host-secret-store

# Production must remain true. Local plain-HTTP smoke tests may set false.
PLACEDB_SECURE_COOKIES=true

# Writable local fallback for avatar objects. Mount this as persistent runtime
# data on a single host. A later S3-compatible adapter uses the same DB keys.
PLACEDB_AVATAR_STORAGE_PATH=/var/lib/placedb/avatars
